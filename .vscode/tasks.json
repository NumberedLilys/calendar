{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Calendar Window App",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/calendarUi.cpp",
                "${workspaceFolder}/src/calendar.cpp",
                "${workspaceFolder}/src/UserFiles.cpp",
                "-I${workspaceFolder}/include",
                "-L${workspaceFolder}/bin",
                "-lSDL3",
                "-o",
                "${workspaceFolder}/bin/calendar.exe",
                "-pg"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}